{
  "name": "nestjs-cryptography",
  "version": "3.2.8",
  "author": {
    "name": "Marc Jorge Gonzalez",
    "url": "https://github.com/voidentropy"
  },
  "license": "MIT",
  "description": "Secure NestJS cryptography module 🔐",
  "homepage": "https://nestjs-cryptography.voidentropy.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voidentropy/nestjs-cryptography.git"
  },
  "bugs": {
    "url": "https://github.com/voidentropy/nestjs-cryptography/issues"
  },
  "scripts": {
    "build": "rimraf -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write \"lib/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint --fix",
    "publish:npm": "npm publish --access=public",
    "prepublish": "yarn run build",
    "prepack": "yarn run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "all": "yarn format && yarn lint && yarn test && yarn prepack"
  },
  "dependencies": {
    "argon2": "^0.45.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "30.5.2",
    "prettier": "^3.9.9",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/wiki/"
    ],
    "modulePathIgnorePatterns": [
      "/wiki/"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testMatch": [
      "**/test/**/?(*.)+(spec|test).[tj]s?(x)"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.ts"
    ],
    "testEnvironment": "node"
  }
}
